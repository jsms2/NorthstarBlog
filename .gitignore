# Dependencies and generated output
node_modules/
.pnpm-store/
.nuxt/
.output/
dist/
coverage/
playwright-report/
test-results/

# Local configuration and logs
.env
.env.*
!.env.example
*.log
logs/

# Runtime data (retain empty directory markers only)
data/uploads/*
!data/uploads/.gitkeep
data/backups/*
!data/backups/.gitkeep
data/temp/*
!data/temp/.gitkeep
/uploads/
/backups/
/temp/
/public/uploads/

# Database exports; Prisma migrations are source and must be committed
*.sql
!prisma/migrations/**/migration.sql
*.sql.gz
*.dump
backup-*.zip

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp
*.temp
