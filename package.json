{
  "name": "northstar-blog",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare && prisma generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.mjs",
    "backup:db": "tsx scripts/backup-db.ts",
    "backup:site": "tsx scripts/backup-site.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@prisma/client": "6.19.0",
    "@tiptap/extension-code-block-lowlight": "3.31.3",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "@tiptap/vue-3": "3.31.3",
    "archiver": "8.0.0",
    "argon2": "0.45.1",
    "cookie-es": "3.1.1",
    "file-type": "22.1.1",
    "katex": "0.18.7",
    "lowlight": "3.3.0",
    "marked": "18.0.14",
    "mermaid": "12.0.0",
    "nanoid": "6.0.1",
    "nuxt": "4.5.2",
    "otpauth": "9.5.2",
    "qrcode": "1.5.4",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "turndown": "7.2.4",
    "ua-parser-js": "2.0.10",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.63.0",
    "@types/archiver": "8.0.0",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.2",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.4",
    "prettier": "3.9.8",
    "prisma": "6.19.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
